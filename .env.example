# Names only. Values live in Vercel and in your local .env.local, never in the repo.

# Set by Vercel: production | preview | development
VERCEL_ENV=

# 1 makes the build fail on any [TODO: …] placeholder (production deployment from the launch branch)
REQUIRE_CONTENT=

# Contact form (src/lib/env.ts). In production the API key, CONTACT_TO and ARCJET_KEY are required.
# Resend API key that sends the contact form's email
RESEND_API_KEY=
# The private inbox that receives the form (never published)
CONTACT_TO=
# Sender as "Name <address>"; defaults to Abdelhadev <onboarding@resend.dev> until the domain is verified
CONTACT_FROM=
# Arcjet site key for the form's rate limit and bot detection (bot detection blocks only when VERCEL_ENV=production)
ARCJET_KEY=
# 1 validates and reports success without calling Resend or Arcjet (tests only; refused in production)
CONTACT_DRY_RUN=
