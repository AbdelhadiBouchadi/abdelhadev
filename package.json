{
  "name": "abdelhadev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/report-todos.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "test:motion": "playwright test --config playwright.motion.config.ts",
    "lhci": "lhci autorun",
    "brand:paths": "node scripts/build-brand-paths.mjs"
  },
  "dependencies": {
    "@arcjet/next": "1.14.0",
    "@gsap/react": "2.1.2",
    "@react-email/render": "2.1.0",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.32.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
